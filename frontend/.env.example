# Same SmartUser initialization as Bravigo. Expo inlines EXPO_PUBLIC_ values.
EXPO_PUBLIC_SMARTUSER_APP_ID='test.bolt.app'
EXPO_PUBLIC_SMARTUSER_SECRET='<secret>'
EXPO_PUBLIC_SMARTUSER_ENV='STAG'
EXPO_PUBLIC_LOG_SMARTUSER=false

# Supabase and DV Live development integration. Use an anon/publishable key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY='<supabase-anon-or-publishable-key>'
DVLIVE_BEARER_TOKEN='<dvlive-bearer>'
SHOW_VOTE_UUID=11111111-1111-4111-8111-111111111101
