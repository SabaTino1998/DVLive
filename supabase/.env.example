# DV Live environment: DEV, STAG or PROD. Loaded with --env-file supabase/.env.
# Access mode: INT or PROD (default when absent). INT uses internal hosts and the bearer token below.
DVLIVE_MODE=PROD
# Required in both INT and PROD modes; never expose this server token to the frontend.
DVLIVE_API_TOKEN=<api-token>
DVLIVE_ENV=STAG
DVLIVE_LOG_ENABLE=FALSE
DVLIVE_LOG_LEVEL=WARNING
# Environment variable DVLive's.
DVLIVE_SMART_USER_APP_ID=<dvlive-server-app-id>
DVLIVE_SMART_USER_APP_SECRET=<dvlive-server-app-secret>
# PROD-only optional ALB token for X-Internal-Auth: only DVLIVE_ALB_TOKEN_${DVLIVE_ENV}
# is read and passed to the SDK.
# Leave unset to omit the header. Never commit real values.
# DVLIVE_ALB_TOKEN_DEV=<alb-token-for-dev-webshow-engine>
# DVLIVE_ALB_TOKEN_STAG=<alb-token-for-stag-webshow-engine>
# DVLIVE_ALB_TOKEN_PROD=<alb-token-for-webshow-engine>
SMART_USER_APP_ENV=STAG
# The proxy and dvlive use APP_JWT_SECRET, falling back to SUPABASE_JWT_SECRET.
# Supabase provides its own URL, anon/service-role keys and JWT secret locally.
# DVLive verification requires one of these signing secrets.
# GoTrue tokens must use HS256 with the matching secret.
# APP_JWT_SECRET=<server-only-signing-secret>
# Base URLs for DEV, STAG and PROD are configured in the SDK.
# Never expose DVLIVE_ALB_TOKEN_* to app clients.
#
APP_JWT_SECRET=<supabase status -o env JWT_SECRET key>
